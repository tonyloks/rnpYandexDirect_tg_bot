# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Database connection string
DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/bot

# Application timezone (e.g., Europe/Moscow, Asia/Yekaterinburg, UTC)
APP_TIMEZONE=Europe/Moscow

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# KMS key for token encryption (base64-encoded 32-byte key)
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
APP_KMS_KEY=base64:CHANGEME_REPLACE_WITH_REAL_KEY_FROM_GENERATOR

# Access Control
# Your Telegram user ID (get from @userinfobot)
OWNER_TG_ID=123456789

# Comma-separated list of allowed Telegram user IDs (optional)
ALLOWED_TG_IDS=111111111,222222222

# Access mode: owner-only | allowlist
ACCESS_MODE=allowlist

# Allow group chats (true/false)
ALLOW_GROUP_CHATS=false

# Yandex.Direct OAuth (optional, if using OAuth flow)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URL=

# FastAPI settings
API_HOST=0.0.0.0
API_PORT=8080

# Feature flags
ENABLE_CACHE=false
